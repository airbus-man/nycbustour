{
  "name": "nycbustour-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "NYC Bus Tour 서비스 대시보드 (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nycbustour-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nycbustour-db --remote",
    "db:seed:local": "wrangler d1 execute nycbustour-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute nycbustour-db --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "4.156.1"
  }
}
